#
# The bundled ka9q-radio radiod of one receiver: coaxhub-radiod@<receiver_id>.service.
# Its config is rendered from the receiver's profile and receivers.json before
# every start; it is never edited by hand. stationd starts, restarts and stops
# the instances over D-Bus (the polkit rule); nothing enables them.
# Only stationd talks to it, over multicast on the loopback interface.

[Unit]
Description=CoaxHub station receiver %i (bundled ka9q-radio radiod)
Documentation=https://github.com/CoaxHub/stationd/blob/main/docs/packaging.md

[Service]
Type=simple
User=coaxhub-radiod
Group=coaxhub-radiod
RuntimeDirectory=coaxhub-radiod/%i
RuntimeDirectoryMode=0755
StateDirectory=coaxhub-radiod
StateDirectoryMode=0755
# radiod's sockets send with IP_MULTICAST_IF=lo, which needs the MULTICAST
# flag on lo; without it radiod exits (radiod notes §2). `+`: this one
# command runs as root, outside the sandbox below.
ExecStartPre=+ip link set dev lo multicast on
# Render this receiver's radiod.conf from its profile's template and
# receivers.json (the serial, the centre, the settings and the multicast
# groups of its slot).
ExecStartPre=/usr/bin/stationd backend-config --receiver %i
ExecStart=/usr/lib/coaxhub/radiod/radiod /run/coaxhub-radiod/%i/radiod.conf
Restart=on-failure
RestartSec=5

# Realtime scheduling for the DSP threads; nothing else.
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
# Network: loopback and multicast only (radiod's groups use TTL 0).
IPAddressAllow=localhost multicast
IPAddressDeny=any
# libusb uses netlink for hotplug events.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Devices: USB device nodes only; the udev rule makes the RTL-SDR's node
# group-accessible to coaxhub-radiod and to nobody else.
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0022
