# SPDX-License-Identifier: GPL-3.0-only
#
# stationd: the CoaxHub station daemon. It holds the station key, dials out to
# the home hub and drives the receivers' radiod instances: it asks
# coaxhub-helper (a root helper on /run/coaxhub-helper.sock) to start, restart
# and stop coaxhub-radiod@<receiver_id>.service, and reads their state from
# systemd. It has no device access and no capabilities, and asks no polkit.

[Unit]
Description=CoaxHub station daemon
Documentation=https://github.com/CoaxHub/stationd/blob/main/docs/packaging.md
# A Pi has no clock battery: TLS and enrollment need NTP time first.
# The package enables systemd-time-wait-sync.
Wants=network-online.target time-sync.target systemd-time-wait-sync.service
After=network-online.target time-sync.target systemd-time-wait-sync.service
# The helper's socket. Wants, not Requires: without it stationd still runs
# (the tunnel, the reports, doctor) and says why no receiver starts.
Wants=coaxhub-helper.socket
After=coaxhub-helper.socket

[Service]
Type=simple
User=coaxhub
Group=coaxhub
ExecStart=/usr/bin/stationd run
# status.json for `stationd status`.
RuntimeDirectory=coaxhub/stationd
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
# Exit 3: not enrolled, or the certificate was revoked. Restarting cannot
# help; `stationd enroll` can (station protocol §2.2).
RestartPreventExitStatus=3

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/coaxhub
# AF_UNIX: the helper's socket (/run/coaxhub-helper.sock), which starts the
# receivers' units, and the system bus socket (/run/dbus/system_bus_socket),
# which systemctl show reads their state from. PrivateTmp, PrivateDevices and
# ProtectSystem leave /run readable, so both are reachable.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=multi-user.target
