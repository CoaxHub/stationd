#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# coaxhub-stationd prerm: stops the services on removal. An upgrade leaves
# them running; the new postinst restarts them.
set -e

case "$1" in
remove | deconfigure)
	if [ -d /run/systemd/system ]; then
		systemctl stop stationd.service coaxhub-radiod.service || true
	fi
	;;
upgrade | failed-upgrade) ;;
*)
	echo "prerm called with unknown argument '$1'" >&2
	exit 1
	;;
esac

exit 0
