#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# coaxhub-stationd prerm: on removal stops stationd and then every receiver's
# radiod instance (coaxhub-radiod@<receiver_id>.service). An upgrade leaves
# them running; the new postinst restarts them.
set -e

case "$1" in
remove | deconfigure)
	if [ -d /run/systemd/system ]; then
		systemctl stop stationd.service || true
		# A pattern: systemctl matches it against the loaded units.
		systemctl stop 'coaxhub-radiod@*.service' || true
	fi
	;;
upgrade | failed-upgrade) ;;
*)
	echo "prerm called with unknown argument '$1'" >&2
	exit 1
	;;
esac

exit 0
